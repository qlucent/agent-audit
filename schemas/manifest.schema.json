{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qlucent agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent"],
  "properties": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "domain": { "enum": ["fintech", "healthcare", "helpdesk", "hr", "finance-ops", "ecommerce", "devops", "it-admin", "general"] },
        "acts_for": { "type": "array", "items": { "type": "string", "not": { "const": "agent" }, "description": "agent is reserved for the matrix column" } }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": { "not": { "const": "agent" } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allow"],
        "properties": { "allow": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^ :]+(:(<=[0-9]+([.][0-9]+)?|(?!own-$)[^ :<]+))?$", "description": "<target>[:<qualifier>]: target is an effect or a glob over the full action name; qualifier is own, own-<glob>, <=N or <glob>. See CONTRIBUTING." } } }
      }
    },
    "approvals": { "type": "array", "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_amount": { "type": "number" },
          "currency": { "type": "string" },
          "per_day": { "type": "number" }
        }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "actions": {
      "description": "Action-name glob (* and ?, case-insensitive) -> declared effects and data classes. Declared lists replace the classifier's for matching actions.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effects": { "type": "array", "items": { "enum": ["read", "write", "delete", "money", "external-send", "identity-admin", "code-exec", "bulk"] } },
          "data": { "type": "array", "items": { "enum": ["pii", "phi", "financial-data", "credentials"] } }
        }
      }
    }
  }
}
