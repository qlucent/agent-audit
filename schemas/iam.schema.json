{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-audit AWS IAM catalogue",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["pattern", "label", "effects"],
    "properties": {
      "pattern": { "type": "string", "minLength": 1 },
      "label": { "type": "string", "minLength": 1 },
      "effects": { "type": "array", "items": { "enum": ["read", "write", "delete", "money", "external-send", "identity-admin", "code-exec", "bulk"] } },
      "data": { "type": "array", "items": { "enum": ["pii", "phi", "financial-data", "credentials"] } }
    }
  }
}
