{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-audit rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "severity", "check", "why", "fix", "references", "fixtures"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "check": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "fix": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail", "pass"],
      "properties": {
        "fail": { "$ref": "#/definitions/fixtureList" },
        "pass": { "$ref": "#/definitions/fixtureList" }
      }
    }
  },
  "definitions": {
    "fixtureList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config"],
        "properties": { "file": { "type": "string" }, "config": {} }
      }
    }
  }
}
