{
  "name": "@qlucent/agent-audit",
  "version": "0.1.0",
  "description": "Audit AI agent tool definitions, OpenAPI specs, scopes and IAM policies for excess permissions. Runs locally.",
  "type": "module",
  "author": "Qlucent (https://qlucent.com)",
  "license": "Apache-2.0",
  "homepage": "https://qlucent.com/tools/agent-audit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlucent/agent-audit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-audit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "data": "node scripts/compile-data.ts",
    "prepublishOnly": "npm run build && npm test",
    "build": "npm run data && tsc -p tsconfig.build.json",
    "test": "npm run data && node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "npm run data && tsc --noEmit"
  },
  "dependencies": {
    "@qlucent/mcp-audit": "0.1.0",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "typescript": "6.0.3"
  },
  "bugs": {
    "url": "https://github.com/qlucent/agent-audit/issues"
  }
}
